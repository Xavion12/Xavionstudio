{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartgym-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "smartgym-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "python",
        "backend/scripts/dev_server.py",
        "--seed"
      ],
      "port": 8787
    }
  ]
}
