{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Live updates for app.xavionfitness.in: one Durable Object holds every open app's WebSocket.
	// It has no public URL of its own: the main Worker (backend/, "smartgym-api") checks each
	// connection's ticket and hands it over through the REALTIME binding. Deploy this first.
	"name": "xavion-realtime",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "HUB",
				"class_name": "RealtimeHub"
			}
		]
	},
	// SQLite-backed Durable Objects are included in the Workers Free plan.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}
