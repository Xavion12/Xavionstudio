{
  "name": "Gym member app",
  "short_name": "Gym",
  "description": "Gym management and member app: memberships, UPI payments, QR attendance, workouts and progress.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0a0b0e",
  "theme_color": "#16181d",
  "categories": ["fitness", "business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Scan attendance", "short_name": "Scan", "url": "/attendance", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My QR", "short_name": "My QR", "url": "/portal/qr", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
